# Add this block to the WiFi billing Caddyfile on the VM
# (/apps/wifibilling/docker/caddy/Caddyfile), then reload Caddy:
#   docker exec beris-caddy caddy reload --config /etc/caddy/Caddyfile
# Caddy gets the Let's Encrypt certificate automatically once the DNS A record points at the VM.
# Replace alcawakagardens.com with the real domain. The website itself is hosted elsewhere (e.g. Vercel).

api.alcawakagardens.com {
    encode zstd gzip
    reverse_proxy alcawaka-api:8080
}
