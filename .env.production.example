# Alcawaka Gardens — production environment for docker-compose.yml on the shared VM.
# On the VM (/apps/be-alcawaka): cp .env.production.example .env, fill in every <...>, never commit it.
# Values in <> are yours to provide. Everything else is a sensible production default.
#
# Domains: the API on this VM at the api. subdomain; the website, staff portal and POS hosted elsewhere, e.g.
#   https://api.alcawakagardens.com  (this API, via beris-caddy)
#   https://alcawakagardens.com      (FE-alcawaka-gardens on Vercel; set NUXT_PUBLIC_API_BASE=https://api.<your-domain>/api there)

APP_NAME="Alcawaka Gardens"
APP_ENV=production
APP_KEY=<run after the first build: docker run --rm alcawaka-api:latest php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://api.<your-domain>
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Docker network of the WiFi billing stack, where beris-caddy runs (HTTPS for the API domain).
# Find it on the VM: docker network ls | grep beris
PROXY_NETWORK=<e.g. wifibilling_beris>

# Links in emails (confirmations, invitations, password resets) point here.
FRONTEND_URL=https://<your-domain>

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database: the alcawaka-postgres service (its own volume; separate from billing and Campus 360).
DB_CONNECTION=pgsql
DB_HOST=alcawaka-postgres
DB_PORT=5432
DB_DATABASE=alcawaka
DB_USERNAME=alcawaka
DB_PASSWORD=<long random password>

# No Redis: logins use tokens (no sessions) and nothing is queued. Cache and scheduler locks live in Postgres.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Email: Resend HTTP API (HTTPS, so blocked SMTP ports on the VM don't matter).
MAIL_MAILER=resend
RESEND_API_KEY=<Resend API key with sending access>
# Must be on a domain verified in Resend (Domains page).
MAIL_FROM_ADDRESS=bookings@<your-domain>
MAIL_FROM_NAME="${APP_NAME}"

# Online payments. Keep the simulator OFF in production: with no gateway connected yet, card and
# mobile-money payments wait until staff approve them in Payments, and cash on arrival works as normal.
PAYMENT_SIMULATOR=false
PAYMENT_HOLD_MINUTES=10
